# Google AI Studio API Key (Free tier: https://aistudio.google.com/)
GEMINI_API_KEY=your_free_ai_studio_api_key_here

# Stock footage APIs (free tiers)
PEXELS_API_KEY=your_free_pexels_key
PIXABAY_API_KEY=your_free_pixabay_key

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# YouTube Data API v3 OAuth Credentials (Headless CI)
YOUTUBE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth_refresh_token
